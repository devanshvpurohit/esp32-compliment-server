# WorkBetter — Environment Variables
# Copy this file to .env.local and fill in your values.
# Then run: vercel env pull .env.local   (to sync from Vercel dashboard)

# ── Upstash Redis ─────────────────────────────────────────────────────────────
# Get these from https://console.upstash.com → your database → REST API section
UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here

# ── Frontend (optional) ───────────────────────────────────────────────────────
# Leave empty when frontend and API are on the same Vercel domain.
# Set to your full Vercel URL during local-only frontend development:
#   VITE_API_URL=http://localhost:3000
VITE_API_URL=
