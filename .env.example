# ESP32 Compliment Server Configuration
# Copy this file to .env and update with your settings

# Server Configuration
SERVER_PORT=3000

# ESP32 Settings
ESP32_IP=192.168.4.1
ESP32_PORT=80

# Timing (in minutes)
COMPLIMENT_INTERVAL_MINUTES=10

# Optional: External API
USE_EXTERNAL_API=false
EXTERNAL_API_URL=https://your-api.com/compliment
